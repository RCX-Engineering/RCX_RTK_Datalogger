// Configurations. The logger is used in one configuration at a time; each variation point names
// the alternatives, and every element that exists only in some of them lists those in `variants`.
// Elements with no `variants` property are present in every configuration.
CREATE (vp_usb_c:VariationPoint {id: 'vp_usb_c', name: 'USB-C connection', default_variant: 'var_usb_power', notes: 'The same USB-C cable goes to the development PC while programming or debugging, and to a USB power source in use.'})
CREATE (var_usb_power:Variant {id: 'var_usb_power', name: 'In use: USB power source'})
CREATE (var_usb_pc:Variant {id: 'var_usb_pc', name: 'Programming and debugging: development PC'})
CREATE (vp_vehicle_bus:VariationPoint {id: 'vp_vehicle_bus', name: 'Vehicle CAN bus', default_variant: 'var_718_chassis', notes: 'The transceiver CAN pigtail takes one vehicle lead at a time, for one car and one bus, or is left free.'})
CREATE (var_718_chassis:Variant {id: 'var_718_chassis', name: 'Porsche 718 Chassis bus'})
CREATE (var_718_drive:Variant {id: 'var_718_drive', name: 'Porsche 718 Drive bus'})
CREATE (var_987_2_drive:Variant {id: 'var_987_2_drive', name: 'Porsche 987.2 Drive bus'})
CREATE (var_frs_obd:Variant {id: 'var_frs_obd', name: 'Scion FR-S CAN at the OBD-II port'})
CREATE (var_no_vehicle:Variant {id: 'var_no_vehicle', name: 'No vehicle attached'})

