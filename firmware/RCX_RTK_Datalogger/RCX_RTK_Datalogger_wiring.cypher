// Porsche 718 chassis bus through the same PosiTaps.
MATCH (a {id: 'porsche_718'}), (b {id: 'porsche_718_can_chassis'}) CREATE (a)-[:HAS_CAN_BUS {}]->(b)
MATCH (a {id: 'positap_can_h'}), (b {id: 'porsche_718_can_chassis'}) CREATE (a)-[:TAPS_VEHICLE_CAN {vehicle_id: 'porsche_718', bus_name: 'Chassis CAN', signal: 'CAN-H', polarity: '+', vehicle_wire_color: 'ORG/VIO', vehicle_wire_color_full: 'orange/violet', color_status: 'unconfirmed: owner recollection; no readable source found', color_source: 'Owner recollection (orange/purple). Consistent with the VAG pattern (orange base, bus-specific stripe on CAN-High), but VW service information assigns orange/violet to the infotainment CAN; the Rennlist thread "718 CAN Chassis Bus Decoding" could not be opened to confirm.'}]->(b)
MATCH (a {id: 'positap_can_l'}), (b {id: 'porsche_718_can_chassis'}) CREATE (a)-[:TAPS_VEHICLE_CAN {vehicle_id: 'porsche_718', bus_name: 'Chassis CAN', signal: 'CAN-L', polarity: '-', vehicle_wire_color: 'ORG/BRN', vehicle_wire_color_full: 'orange/brown', color_status: 'unconfirmed for this bus; matches the VAG convention', color_source: 'Owner recollection; VW service information gives orange/brown for every CAN-Low. No 718 chassis-specific source could be opened.'}]->(b)

