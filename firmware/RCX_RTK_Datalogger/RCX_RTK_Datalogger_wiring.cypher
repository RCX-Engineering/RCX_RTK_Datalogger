// Enclosure-boundary and external-interface model.
CREATE (rcx_enclosure:Enclosure {id: 'rcx_enclosure', name: 'RCX RTK Datalogger enclosure', type: '3D-printed electronics enclosure', diagram_level: 'primary', diagram_group: 'enclosure', diagram_order: 0, notes: 'Internal electronics are contained here. Externally accessible interfaces are USB-C (5V power and native USB data), the GNSS antenna connection, and the transceiver CAN pigtail, which leaves the enclosure from the SN65 parallel CAN header.'})
CREATE (lg290p_antenna_connector:Connector {id: 'lg290p_antenna_connector', name: 'LG290P antenna connector', device: 'lg290p', type: 'RF antenna connector', connector_standard: 'TBD from exact LG290P carrier/module', role: 'GNSS RF input', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', interface_exposure: 'external', external_interface: true, interface_type: 'gnss_antenna', cover_label: 'GNSS ANTENNA', cover_order: 20, diagram_level: 'primary', diagram_group: 'external_interface', diagram_order: 35, physical_position_status: 'connector location and standard not yet dimensioned', notes: 'Externally accessible antenna connection on the LG290P module.'})
CREATE (external_gnss_antenna:Antenna {id: 'external_gnss_antenna', name: 'External multiband GNSS antenna', type: 'active GNSS antenna', enclosure_scope: 'external', diagram_level: 'primary', diagram_group: 'external_device', diagram_order: 65, mounting: 'vehicle exterior or other sky-view location', notes: 'The antenna cable is permanently attached at the antenna and ends in the antenna cable plug, which mates with the LG290P antenna connector.'})
CREATE (host_pc:Host {id: 'host_pc', variants: ['var_usb_pc'], name: 'Development PC running Arduino IDE', type: 'USB host', role: 'firmware upload and serial monitor over the ESP32-S3 USB Serial/JTAG port', connection: 'USB-C cable to the ESP32 onboard USB-C connector', attached: 'during development; in the vehicle the same port takes 5V from a USB supply', enclosure_scope: 'external', diagram_level: 'primary', diagram_group: 'external_device', diagram_order: 5})
