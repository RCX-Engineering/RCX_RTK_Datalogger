// RCX RTK Datalogger — wiring knowledge graph logical physics model

CREATE (esp32:Device {id: 'esp32', name: 'ESP32-S3-LCD-1.47B', type: 'MCU board', manufacturer: 'Waveshare', input_power: '5V via onboard USB-C connector', logic_level: '3.3V', physical_position_status: 'partial: external-header side and order are captured; millimeter pin coordinates are not yet captured', notes: 'ESP32-S3 board with onboard LCD, SD card, IMU, USB-C power/data, and left and right external GPIO headers.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'primary', diagram_group: 'controller', diagram_order: 10})
CREATE (lg290p:Device {id: 'lg290p', name: 'LG290P RTK GNSS module', type: 'GNSS receiver', voltage_in: '3.3V', logic_level: '3.3V', physical_position_status: 'connector ownership is captured; pin order and millimeter coordinates are not yet captured', notes: 'GNSS module 3.3V and GND leads are doubled into the VCC and GND positions of the SN65 4-pin plug, which is fed from the ESP32 3-pin power plug. UART connector is physically on the GPS module; the harness plugs into it with a JST SH cable plug.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'primary', diagram_group: 'gnss', diagram_order: 30})
CREATE (sn65:Device {id: 'sn65', name: 'SN65HVD230 CAN transceiver module', type: 'CAN transceiver breakout', voltage_in: '3.3V', logic_level: '3.3V', can_physical_layer: 'ISO 11898-2 high-speed CAN', physical_position_status: 'dimensioned from user-supplied STEP/STL', coordinate_frame: 'sn65_component_side_xz_v1', cad_source_step: 'CAN Transiver SN65HVD230.step', cad_source_stl: 'CAN Transiver SN65HVD230.stl', assembly_size_x_mm: 32.4903, assembly_size_y_mm: 10.2756, assembly_height_mm: 13.7764, notes: '3.3V CAN transceiver used as receive interface for vehicle CAN. TXD is wired but firmware may operate in listen-only mode.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'primary', diagram_group: 'can', diagram_order: 40})
CREATE (fan:Device {id: 'fan', name: '5V cooling fan', type: 'two-wire DC brushless fan', voltage_in: '5V', leads: 2, lead_termination: 'flying leads, no connector at the fan', control: 'none; runs whenever the board 5V rail is live', notes: 'Powered from the USB VBUS rail: +5V lead in the 5V position and ground doubled into the GND position of the ESP32 3-pin power plug.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'primary', diagram_group: 'thermal', diagram_order: 25})
CREATE (esp32_usb_c:Connector {id: 'esp32_usb_c', name: 'ESP32 onboard USB-C connector', device: 'esp32', type: 'USB-C receptacle', role: '5V power input and native USB data (USB Serial/JTAG) for firmware upload and serial monitor', physical_location: 'top edge of ESP32 board', board_side: 'top', notes: 'External 5V USB-C power is applied here. D+ and D- run on-board to ESP32-S3 GPIO20 and GPIO19 (native USB, no USB-UART bridge); the Arduino IDE uploads and monitors through this port.', data_interface: 'native USB Serial/JTAG', data_pins: 'GPIO19 USB_D-, GPIO20 USB_D+', physical_model: 'Connector is physically mounted on and logically owned by the ESP32-S3 board.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', interface_exposure: 'external', external_interface: true, interface_type: 'power_usb', cover_label: 'USB-C / 5V INPUT', cover_order: 10, diagram_level: 'primary', diagram_group: 'external_interface', diagram_order: 15})
CREATE (lg290p_uart_connector:Connector {id: 'lg290p_uart_connector', name: 'LG290P onboard UART connector', type: 'JST SH 1.0 mm 4-pin header', series: 'JST SH', positions: 4, nominal_pitch_mm: 1.0, user_gender: 'male header', identification: 'inferred from the Waveshare LG290P GNSS RTK Module documentation (UART on an SH1.0 4-pin connector); confirm against the board in hand', device: 'lg290p', pins: '3.3V, GND, TX, RX', notes: 'This connector is physically on the GPS module, not a separate inline harness connector.', physical_model: 'Connector is physically mounted on and logically owned by the LG290P module.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'detail'})
CREATE (sn65_logic_power_connector:Connector {id: 'sn65_logic_power_connector', name: 'SN65HVD230 4-pin logic/power header', type: '1x4 male pin header', user_gender: 'male header', device: 'sn65', positions: 4, nominal_pitch_mm: 2.54, measured_pitch_mm: 2.52, pins_component_side_top_to_bottom: ['VCC', 'GND', 'RXD', 'TXD'], physical_edge: 'logic-header end', contact_direction: '-X in sn65_component_side_xz_v1', notes: 'Carries 3.3V, ground, TWAI RXD, and TWAI TXD between the ESP32 header and the CAN transceiver module.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'detail'})
CREATE (can_logic_power_plug:Connector {id: 'can_logic_power_plug', name: 'SN65 4-pin logic/power plug', type: '4-position housing', user_gender: 'female housing', positions: 4, nominal_pitch_mm: 2.54, pins_top_to_bottom: ['VCC', 'GND', 'RXD', 'TXD'], notes: 'Plugs onto the SN65 1x4 logic/power header. The VCC and GND positions each hold two wires: the LG290P lead and the lead to the ESP32 3-pin power plug, which splices GPS power onto the CAN module supply.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'primary', diagram_group: 'can', diagram_order: 38})
CREATE (esp32_power_plug:Connector {id: 'esp32_power_plug', name: 'ESP32 3-pin power plug', type: '3-position housing', user_gender: 'female housing', positions: 3, nominal_pitch_mm: 2.54, notes: 'Plugs onto ESP32 left-header positions 1 to 3 (5V, GND, 3V3(OUT)) and carries all three power leads to the board. The GND position holds two wires: the ground lead from the SN65 4-pin plug and the fan ground.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'primary', diagram_group: 'power', diagram_order: 12})
CREATE (sn65_can_screw_terminal:Connector {id: 'sn65_can_screw_terminal', name: 'SN65HVD230 CAN screw terminal', type: '2-position PCB screw terminal', device: 'sn65', positions: 2, preferred_connection: false, position_1_signal: 'CANL', position_2_signal: 'CANH', component_side_order: 'CANL upper, CANH lower', measured_center_spacing_mm: 4.7390, notes: 'CANH and CANL screw terminals are electrically parallel with the nearby plated pads. Not used: the CAN pigtail plugs onto header pins fitted in the parallel pads.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'detail'})
CREATE (sn65_can_parallel_pads:Connector {id: 'sn65_can_parallel_pads', name: 'SN65HVD230 parallel CAN header', type: '1x2 male pin header in the parallel CAN pads', device: 'sn65', positions: 2, nominal_pitch_mm: 2.54, user_gender: 'male header', preferred_connection: true, position_1_signal: 'CANL', position_2_signal: 'CANH', component_side_order: 'CANL upper, CANH lower', measured_center_spacing_mm: 2.52, notes: 'Male header pins in the plated pads that are electrically parallel with the CAN screw terminals. The transceiver CAN pigtail plugs on here for every vehicle.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', diagram_level: 'detail'})
CREATE (can_pigtail_socket:Connector {id: 'can_pigtail_socket', name: 'CAN pigtail Dupont female housing', type: '2-position Dupont housing', series: 'Dupont', positions: 2, nominal_pitch_mm: 2.54, user_gender: 'female housing', mounting: 'on the transceiver CAN pigtail', pin_1_signal: 'CANL', pin_2_signal: 'CANH', housing_status: 'assumed one 2-position housing; not recorded', notes: 'Plugs onto the male header pins in the SN65 parallel CAN pads. Pin 1 is CANL; pin 2 is CANH.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal', interface_exposure: 'external', external_interface: true, interface_type: 'vehicle_can', cover_label: 'VEHICLE CAN', cover_order: 30, diagram_level: 'primary', diagram_group: 'can', diagram_order: 41})
CREATE (can_pigtail_plug:Connector {id: 'can_pigtail_plug', name: 'CAN pigtail Dupont male plug', type: '2-position Dupont male housing', series: 'Dupont', positions: 2, nominal_pitch_mm: 2.54, user_gender: 'male plug', mounting: 'on the transceiver CAN pigtail', pin_1_signal: 'CANL', pin_2_signal: 'CANH', housing_status: 'assumed one 2-position housing; not recorded', notes: 'Male Dupont pins at the free end of the pigtail. The vehicle lead in use plugs on here; with no vehicle attached it is left free.', enclosure_scope: 'external', diagram_level: 'primary', diagram_group: 'external_harness', diagram_order: 55})
