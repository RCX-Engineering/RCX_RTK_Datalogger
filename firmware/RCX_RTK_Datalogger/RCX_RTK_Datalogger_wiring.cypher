CREATE (usb_c_cable:Harness {id: 'usb_c_cable', name: 'USB-C cable', type: 'jacketed cable', jacketed: true, wires: 4, conductors: ['VBUS', 'GND', 'D+', 'D-'], notes: 'One jacketed cable from the development PC (or a USB supply) to the ESP32 onboard USB-C receptacle. Its four conductors run together in the same jacket and carry 5V power and native USB data.'})
CREATE (gps_uart:Harness {id: 'gps_uart', name: 'GPS UART signal pair', wires: 2, colors: 'orange, yellow', notes: 'UART signal wires from the LG290P UART cable plug (JST SH) to the ESP32 GPS UART 2-pin plug on header positions 7 and 8.'})
CREATE (can_logic_power:Harness {id: 'can_logic_power', name: 'CAN logic/power 4-pin harness', wires: 4, colors: 'red, black, green, blue', notes: 'Four leads from the SN65 4-pin plug: VCC and GND to the 3V3 and GND positions of the ESP32 3-pin power plug, RXD and TXD to GP8 and GP9 through the ESP32 CAN logic 2-pin plug.'})
CREATE (gps_power:Harness {id: 'gps_power', name: 'GPS power pair', wires: 2, colors: 'red, black', notes: 'LG290P 3.3V and GND leads from the LG290P UART cable plug, doubled into the VCC and GND positions of the SN65 4-pin plug.'})
CREATE (fan_leads:Harness {id: 'fan_leads', name: 'Fan leads', wires: 2, colors: 'red, black', notes: 'Fan +5V and GND into the 5V and GND positions of the ESP32 3-pin power plug.'})
CREATE (can_pigtail:Harness {id: 'can_pigtail', name: 'Transceiver CAN pigtail', wires: 2, colors: 'not recorded', pinout: 'pin 1 CANL; pin 2 CANH at both ends', notes: 'Female Dupont housing on the SN65 parallel CAN header at one end, male Dupont pins at the other. Every vehicle lead plugs onto its male end.', enclosure_id: 'rcx_enclosure', enclosure_scope: 'internal to external', diagram_level: 'detail'})
CREATE (vehicle_can_taps:Harness {id: 'vehicle_can_taps', variants: ['var_718_drive', 'var_718_chassis', 'var_987_2_drive'], name: 'Removable CAN tap lead', wires: 2, colors: 'white, green', pinout: 'pin 1 CANL green; pin 2 CANH white', notes: 'Runs from its Dupont female housing, plugged onto the transceiver CAN pigtail, to the PosiTap connectors. Vehicle-side conductor colors are defined per vehicle on TAPS_VEHICLE_CAN relationships.', enclosure_scope: 'external', diagram_level: 'detail'})
